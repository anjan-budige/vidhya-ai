# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  VIDHYA BOT PLATFORM v3 — Environment Configuration Template               ║
# ║  1. Copy this file:  cp .env.example .env                                  ║
# ║  2. Fill in all YOUR_* values before running docker compose up              ║
# ║  ⚠️  NEVER commit your .env file to version control                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Vidhya Bot
# Telegram requires HTTPS for WebApps — use ngrok or localtunnel in development
APP_URL=http://localhost

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_USER=vidhya
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
POSTGRES_DB=vidhya_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vidhya:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/vidhya_db
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://vidhya:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/vidhya_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_BROKER=redis://redis:6379/1
REDIS_CELERY_BACKEND=redis://redis:6379/2

# ── Settings encryption (AI provider keys live in the DB) ─────────────────────
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Rotating it makes existing encrypted provider keys unreadable.
SETTINGS_ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE

# ── Payments encryption (gateway credentials live in the DB) ──────────────────
# Use a DIFFERENT key from SETTINGS_ENCRYPTION_KEY. Generating a new key makes
# existing payment credentials unreadable, so re-save them in Admin → Payments.
PAYMENTS_ENCRYPTION_KEY=YOUR_FERNET_KEY_HERE
# Demo checkout needs no credentials. It is always allowed outside production;
# set true only for a controlled test in production.
PAYMENTS_DEMO_ENABLED=false

# Embedding model, dimensions and provider are configured in Admin → AI Providers.
# No embedding settings are read from env.

# ── MinIO (Local S3-compatible Object Storage) ────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=YOUR_STRONG_MINIO_PASSWORD_HERE
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_BUCKET=vidhya-documents
MINIO_REGION=us-east-1

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=your_bot_username

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# TOTP 2FA Secret — generate with:
#   python -c "import pyotp; print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=YOUR_TOTP_SECRET_HERE
# Set to true to enforce TOTP 2FA for admin login
ADMIN_TOTP_ENABLED=false

# ── Resend (Transactional Email) ──────────────────────────────────────────────
# Get your API key at: https://resend.com/api-keys
# The from-address domain must be verified in Resend (SPF + DKIM green)
RESEND_API_KEY=re_YOUR_RESEND_API_KEY
RESEND_FROM_EMAIL=info@yourdomain.com
RESEND_FROM_NAME=Vidhya AI
RESEND_REPLY_TO=info@yourdomain.com
SUPERADMIN_EMAIL=your@email.com

# ── Payments ──────────────────────────────────────────────────────────────────
# Gateways (Razorpay, Cashfree, Paytm, PhonePe, PayU) and their credentials are
# configured in Admin → Payments. Demo mode needs no credentials.
# Each provider's webhook URL is shown on its integration screen.

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Generate a strong random CSRF_SECRET with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=YOUR_CSRF_SECRET_HERE

CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ── Session Cookie ────────────────────────────────────────────────────────────
# SameSite=None is required for Telegram WebView cross-origin requests
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict

# ── Celery Task Queue ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=10
