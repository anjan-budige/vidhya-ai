# ╔══════════════════════════════════════════════════════════════════════════════╗
# ║  VIDHYA BOT PLATFORM v3 — Environment Configuration Template               ║
# ║  1. Copy this file:  cp .env.example .env                                  ║
# ║  2. Fill in all YOUR_* values before running docker compose up              ║
# ║  ⚠️  NEVER commit your .env file to version control                         ║
# ╚══════════════════════════════════════════════════════════════════════════════╝

# ── App ───────────────────────────────────────────────────────────────────────
ENV=development
DEBUG=true
LOG_LEVEL=INFO
APP_NAME=Vidhya Bot
# Telegram requires HTTPS for WebApps — use ngrok or localtunnel in development
APP_URL=http://localhost

# ── Database (PostgreSQL + pgvector) ─────────────────────────────────────────
POSTGRES_USER=vidhya
POSTGRES_PASSWORD=YOUR_STRONG_DB_PASSWORD_HERE
POSTGRES_DB=vidhya_db
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://vidhya:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/vidhya_db
# Sync URL for Alembic migrations
DATABASE_URL_SYNC=postgresql://vidhya:YOUR_STRONG_DB_PASSWORD_HERE@postgres:5432/vidhya_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://redis:6379/0
REDIS_CELERY_BROKER=redis://redis:6379/1
REDIS_CELERY_BACKEND=redis://redis:6379/2

# ── Mistral AI API ────────────────────────────────────────────────────────────
# Get your key at: https://console.mistral.ai/api-keys/
MISTRAL_API_KEY=YOUR_MISTRAL_API_KEY_HERE
MISTRAL_CHAT_MODEL=mistral-small-latest
MISTRAL_EMBED_MODEL=mistral-embed
EMBEDDING_DIMENSIONS=1024

# ── MinIO (Local S3-compatible Object Storage) ────────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=YOUR_STRONG_MINIO_PASSWORD_HERE
MINIO_ENDPOINT=http://minio:9000
MINIO_EXTERNAL_ENDPOINT=http://localhost:9000
MINIO_BUCKET=vidhya-documents
MINIO_REGION=us-east-1

# ── Telegram ──────────────────────────────────────────────────────────────────
# Create a bot via @BotFather on Telegram and paste the token here
TELEGRAM_BOT_TOKEN=YOUR_TELEGRAM_BOT_TOKEN_HERE
TELEGRAM_BOT_USERNAME=your_bot_username

# ── Admin Account ─────────────────────────────────────────────────────────────
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=YOUR_STRONG_ADMIN_PASSWORD_HERE

# TOTP 2FA Secret — generate with:
#   python -c "import pyotp; print(pyotp.random_base32())"
ADMIN_TOTP_SECRET=YOUR_TOTP_SECRET_HERE
# Set to true to enforce TOTP 2FA for admin login
ADMIN_TOTP_ENABLED=false

# ── Mailtrap (Transactional Email) ────────────────────────────────────────────
# Get your token at: https://mailtrap.io/api-tokens
MAILTRAP_TOKEN=YOUR_MAILTRAP_TOKEN_HERE
MAILTRAP_SENDER_EMAIL=hello@yourdomain.com
SUPERADMIN_EMAIL=your@email.com

# ── PhonePe (Payment Gateway) ─────────────────────────────────────────────────
# Get credentials from your PhonePe merchant dashboard
# For sandbox testing, use PhonePe UAT credentials
PHONEPE_MERCHANT_ID=YOUR_PHONEPE_MERCHANT_ID_HERE
PHONEPE_SALT_KEY=YOUR_PHONEPE_SALT_KEY_HERE
PHONEPE_SALT_INDEX=1
PHONEPE_ENV=sandbox
PHONEPE_CALLBACK_URL=https://yourdomain.com/api/v1/payments/webhook
PHONEPE_REDIRECT_URL=https://yourdomain.com/payment/status

# ── Security ──────────────────────────────────────────────────────────────────
# Generate a strong random SECRET_KEY with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=YOUR_SECRET_KEY_HERE

# Generate a strong random CSRF_SECRET with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CSRF_SECRET=YOUR_CSRF_SECRET_HERE

CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173

# ── Session Cookie ────────────────────────────────────────────────────────────
# SameSite=None is required for Telegram WebView cross-origin requests
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAMESITE=Strict

# ── Celery Task Queue ─────────────────────────────────────────────────────────
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2
CELERY_WORKER_CONCURRENCY=2

# ── Rate Limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_AI_PER_MINUTE=10
RATE_LIMIT_LOGIN_PER_MINUTE=5
RATE_LIMIT_UPLOAD_PER_HOUR=10
